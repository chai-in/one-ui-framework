  "format": "Framework-neutral semantic role source. Exact sRGB hex values are the WCAG 2.2 luminance contract; OKLCH values are derived deterministically by generate_tokens.py.",
  "policy": {
    "actionBorder": "borderless-filled",
    "actionBorderOptions": [
      "borderless-filled",
      "bordered"
    ],
    "actionBorderNote": "Owner-approved v0.2 refinement promoted to v0.3 default: filled custom action boxes omit decorative borders in both themes while retaining named labels/icons, full focus rings, neutral secondary action separation and essential editable-field boundaries. Consumers may opt into 'bordered' (1px borderStrong, 2px high-contrast) where explicit custom button edges are desired."
